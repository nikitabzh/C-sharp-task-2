<Window x:Class="Task2App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Осветительные приборы" Height="350" Width="600" WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Список приборов" Grid.Column="0" Margin="0,0,10,0">
            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <GroupBox Header="Управление выбранным прибором" Grid.Column="1">
            <StackPanel Margin="10">
                
                <TextBlock Text="Статус работы:" Foreground="Gray"/>
                <TextBlock Text="{Binding SelectedDeviceStatus}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Подключение:" Foreground="Gray"/>
                <TextBlock Text="{Binding PlugStatusText}" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Состояние (исправность):" Foreground="Gray"/>
                <TextBlock Text="{Binding IsBrokenText}" FontSize="14" FontWeight="Bold" Foreground="Red" Margin="0,0,0,15"/>

                <WrapPanel Orientation="Horizontal">
                    <Button Content="Включить (След. режим)" Command="{Binding TurnOnCommand}" Width="150" Height="30" Margin="0,0,10,10"/>
                    <Button Content="Выключить (Пред. режим)" Command="{Binding TurnOffCommand}" Width="150" Height="30" Margin="0,0,10,10"/>
                    <Button Content="Вкл/Выкл из розетки" Command="{Binding TogglePlugCommand}" Width="150" Height="30" Margin="0,0,10,10"/>
                    <Button Content="Починить прибор" Command="{Binding RepairCommand}" Width="150" Height="30" Foreground="DarkGreen" FontWeight="Bold"/>
                </WrapPanel>
                
                <TextBlock Text="*Каждое нажатие Вкл/Выкл имеет шанс сломать прибор." 
                           FontSize="10" Foreground="Gray" Margin="0,20,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>